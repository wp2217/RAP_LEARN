projection;
strict ( 2 );
use draft;

define behavior for ZC_ROC_CODE //alias <alias_name>
{
  use create;
  use update;
  use delete;

  use association _CodeAttach { create; with draft; }

    // for Draft
  use action Edit;
  use action Activate;
  use action Resume;
  use action Discard;
  use action Prepare;
}

define behavior for ZC_ROC_CODE_ATTACH //alias <alias_name>
{
  use update;
  use delete;

  use association _Code{ with draft;}
}