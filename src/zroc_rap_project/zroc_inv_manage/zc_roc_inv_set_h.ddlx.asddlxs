@Metadata.layer: #CORE
@Search.searchable: true
@UI.headerInfo: {
    typeName: 'Manage Invoice Settlement',
    typeNamePlural: 'Settlements',
    //typeImageUrl: 'sap-icon://flight',

    title: {
      type: #STANDARD,
      value: 'SettleNo'
    },

    description: {
      type: #STANDARD,
      value: 'SellerName'
    }
}
annotate entity ZC_ROC_INV_SET_H with
{
  @UI.facet: [
  //*********************Header Start*********************************************
             {  id: 'HeaderInfo',
              purpose: #HEADER,
              type: #FIELDGROUP_REFERENCE,
              targetQualifier: 'tqHeaderInfo',
              position: 10  },

             {  id: 'HeaderNetAmount',
              purpose: #HEADER,
              type: #FIELDGROUP_REFERENCE,
              targetQualifier: 'tqHeaderNetAmount',
              position: 20 },

             {  id: 'HeaderTaxAmount',
              purpose: #HEADER,
              type: #FIELDGROUP_REFERENCE,
              targetQualifier: 'tqHeaderTaxAmount',
              position: 30 },

  //*****************Header End*********************************************

  //*****************Tab Begin*********************************************
              {  id: 'TabSettlement',
              purpose: #STANDARD,
              type: #COLLECTION,//显示具体Object，结合当前节点metadata中UI.identification: [{  position: 30 }]显示字段（定义在当前页面，显示在下一个页面）
              position: 10,
              label: 'Invoice Selection & Basic Data'  },   //Tab页签

              { id: 'SettlementItem',
              purpose: #STANDARD,
              type: #LINEITEM_REFERENCE,   //子节点按行项目显示， 结合子节点metadata中@UI.lineItem: [{  position: 80}]显示字段（定义在下个页面，显示在下一个页面）
              position: 20,
              label: 'GR Items',          //Tab页签
              targetElement: '_invItem'  },

  //*****************Tab End*********************************************

  //*****************Section Begin*********************************************
              {  id:               'Inv_Selection',
                 parentId:         'TabSettlement',
                 purpose:          #STANDARD,
                 type:             #FIELDGROUP_REFERENCE, //#IDENTIFICATION_REFERENCE,
                 label:            'Invoice Selection',
                 targetQualifier:  'tqInv_Selection',
                 position:         10 },

              {  id:               'Settle_Text',
                 parentId:         'TabSettlement',
                 purpose:          #STANDARD,
                 type:             #FIELDGROUP_REFERENCE, //#IDENTIFICATION_REFERENCE,
                 label:            'Settlement Type & Text',
                 targetQualifier:  'tqSettle_Text',
                 position:         20 }

              ]

  //*****************Section End*********************************************

  //**********************Header Field Begin******************************************
  @UI.lineItem: [ { position: 10 } ]
  @UI.selectionField: [ { position: 10 } ]
  @Search.defaultSearchElement: true
  @EndUserText.label: 'Settlement No.'
  SettleNo;

  @UI.lineItem: [ { position: 70 } ]
  @UI.selectionField: [ { position: 60 } ]
  @UI.fieldGroup:     [ { qualifier: 'tqHeaderInfo', position: 10}]
  Bukrs;

  @UI.lineItem: [ { position: 30 } ]
  @UI.selectionField: [ { position: 50 } ]
  @UI.fieldGroup:     [ { qualifier: 'tqHeaderInfo',position: 20} ]
  @Consumption.valueHelpDefinition: [{
    entity: { name: 'ZI_ROC_DOMAIN_VH', element: 'Value' },
    additionalBinding: [
      { localConstant: 'ZDROC_INV_BUS_TYPE', element: 'DomainName', usage: #FILTER }],
    distinctValues: true
  }]
  BusinessType;

  @UI.lineItem: [ { position: 16 } ]
  @UI.selectionField: [ { position: 30 } ]
  @UI.fieldGroup:     [ { qualifier: 'tqHeaderInfo', position: 30}]
  @Consumption.valueHelpDefinition: [{
    entity: { name: 'ZI_ROC_DOMAIN_VH', element: 'Value' },
    additionalBinding: [
      { localConstant: 'ZDROC_SETTLE_TYPE', element: 'DomainName', usage: #FILTER }],
    distinctValues: true
  }]
  SettleType;

  @UI.lineItem: [ { position: 20 } ]
  @UI.selectionField: [ { position: 40 } ]
  @UI.fieldGroup:     [ { qualifier: 'tqHeaderInfo',position: 40} ]
  @Consumption.valueHelpDefinition: [{
  entity: { name: 'ZI_ROC_DOMAIN_VH', element: 'Value' },
  additionalBinding: [
    { localConstant: 'ZDROC_SETTLE_STATUS', element: 'DomainName', usage: #FILTER }],
  distinctValues: true
  }]
  SettleStatus;


  @UI.lineItem: [ { position: 40 } ]
  @UI.selectionField: [ { position: 100 } ]
  @EndUserText.label: 'Gross Amount'
  @UI.fieldGroup:     [ { qualifier: 'tqHeaderInfo', position: 50}, { qualifier: 'tqInv_Selection', position: 50}]
  GrossAmount;

  @UI.lineItem: [ { position: 50 } ]
  @EndUserText.label: 'Net Amount'
  @UI.fieldGroup:     [ { qualifier: 'tqHeaderNetAmount', position: 10}, { qualifier: 'tqInv_Selection', position: 60}]
  NetAmount;

  @EndUserText.label: 'Sellect Net Amount '
  @UI.fieldGroup:     [ { qualifier: 'tqHeaderNetAmount', position: 20}]
  SelectedNetAmount;

  @EndUserText.label: 'Differ Net Amount '
  @UI.fieldGroup:     [ { qualifier: 'tqHeaderNetAmount', position: 30}]
  DiffNetAmount;


  @UI.lineItem: [ { position: 60} ]
  @EndUserText.label: 'Tax Amount'
  @UI.fieldGroup:     [ { qualifier: 'tqHeaderTaxAmount', position: 10}, { qualifier: 'tqInv_Selection', position: 70}]
  TaxAmount;

  @EndUserText.label: 'Sellect Tax Amount '
  @UI.fieldGroup:     [ { qualifier: 'tqHeaderTaxAmount', position: 20}]
  SelectedTaxAmount;

  @EndUserText.label: 'Differ Tax Amount '
  @UI.fieldGroup:     [ { qualifier: 'tqHeaderTaxAmount', position: 30}]
  DiffTaxAmount;
  //**********************Header Field End******************************************

  //**********************Invoice Selection Field Begin******************************************
  @UI.lineItem: [ { position: 15 } ]
  @UI.selectionField: [ { position: 20 } ]
  @EndUserText.label: 'Invoice Number'
  @UI.fieldGroup:     [ { qualifier: 'tqInv_Selection', position: 10, groupLabel:'Invoice Selection'}]

  @Consumption.valueHelpDefinition: [{
  entity: { name: 'ZI_ROC_INVOICE_VH', element: 'InvoiceNo' },
  additionalBinding: [
    { localElement: 'Bukrs',    element: 'Bukrs',    usage: #FILTER }
//    { localElement: 'SellerName',  element: 'SellerName',   usage: #RESULT },
//    { localElement: 'BuyerName', element: 'BuyerName', usage: #RESULT },
//    { localElement: 'InvoiceDate', element: 'InvoiceDate', usage: #RESULT },
//    { localElement: 'NetAmount', element: 'NetAmount', usage: #RESULT },
//    { localElement: 'GrossAmount', element: 'GrossAmount', usage: #RESULT },
//    { localElement: 'TaxAmount', element: 'TaxAmount', usage: #RESULT },
//    { localElement: 'Waers', element: 'Waers', usage: #RESULT },
//    { localElement: 'Bktxt', element: 'Remark', usage: #RESULT }
  ] }]
  @Search.defaultSearchElement: true
  InvoiceNo;

  @UI.lineItem: [ { position: 80 } ]
  @UI.selectionField: [ { position: 70 } ]
  @UI.fieldGroup:     [ { qualifier: 'tqInv_Selection', position: 30}]
  Lifnr;

  @UI.lineItem: [ { position: 90 } ]
  @UI.selectionField: [ { position: 90 } ]
  @EndUserText.label: 'Invoice Date'
  @UI.fieldGroup:     [ { qualifier: 'tqInv_Selection', position: 40}]
  InvoiceDate;
  //**********************Invoice Selection Field End******************************************


  //**********************Text Field End******************************************

  @UI.lineItem: [ { position: 17 } ]
  @UI.fieldGroup:     [ { qualifier: 'tqSettle_Text', position: 20}]
  //  @Consumption.valueHelpDefinition: [{
  //   entity: { name: 'ZI_ROC_DOMAIN_VH', element: 'Value' },
  //   additionalBinding: [
  //     { localConstant: 'ZDROC_TRANS_EVENT', element: 'DomainName', usage: #FILTER }],
  //   distinctValues: true
  //  }]
  @Consumption.valueHelpDefinition: [{ entity: { name: 'ZI_ROC_TRANS_EVENT_VH', element: 'Code' } }]
  TransactionEvent;

  @UI.lineItem: [ { position: 100 } ]
  @UI.selectionField: [ { position: 90 } ]
  @EndUserText.label: 'Header Text'
  @UI.fieldGroup:     [ { qualifier: 'tqSettle_Text', position: 30}]
  Bktxt;

  @UI.lineItem: [ { position: 110 } ]
  @EndUserText.label: 'Assignment Text'
  @UI.fieldGroup:     [ { qualifier: 'tqSettle_Text', position: 40}]
  Sgtxt;
  //**********************Text Field End******************************************


  //  Mwskz;
  //  TaxRate;
  //  Waers;
  //  DpNo;
  //  IdocNumber;
  //  AccountingDocument;
  //  FiscalYear;
  //  BatchCreated;
  //  CreatedBy;
  //  CreatedAt;
  //  LastChangedBy;
  //  LastChangedAt;
  //  /* Associations */
  //  _invItem;

}