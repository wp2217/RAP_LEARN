@Metadata.layer: #CORE
@UI.headerInfo: {
    typeName: 'Manage Invoice Settlement Item',
    typeNamePlural: 'Settlement Items',
    //typeImageUrl: 'sap-icon://flight',

    title: {
      type: #STANDARD,
      value: 'ItemNo'
    },

    description: {
      type: #STANDARD,
      value: 'ShortText'
    }
}
annotate entity ZC_ROC_INV_SET_I with
{
  @UI.facet: [{      id: 'SettleItem',
                     purpose: #STANDARD,
                     type: #IDENTIFICATION_REFERENCE,
                     position: 10,
                     label: 'Settlement Item'  }
                     ]
  //SettleNo;
  @UI.lineItem: [{ position: 10 }]
  @UI.identification: [{  position: 10 }]
  @EndUserText.label: 'Item'
  ItemNo;

  @UI.lineItem: [{ position: 15 }]
  @UI.identification: [{  position: 15 }]
  @UI.hidden: true
  @EndUserText.label: 'Origin Invoice No.'
  InvoiceNo;

  //**************************************  PO Fields **************************************************************
  @UI.lineItem: [{ position: 20 }]
  @UI.identification: [{  position: 20 }]
  @UI.hidden: #(HidePOFields)
  @EndUserText.label: 'PO'
  PurchaseOrder;

