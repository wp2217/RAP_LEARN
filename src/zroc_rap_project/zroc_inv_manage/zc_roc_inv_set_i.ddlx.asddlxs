@Metadata.layer: #CORE
@UI.headerInfo: {
    typeName: 'Manage Invoice Settlement Item',
    typeNamePlural: 'Settlement Items',
    //typeImageUrl: 'sap-icon://flight',

    title: {
      type: #STANDARD,
      value: 'ItemNo'
    },

    description: {
      type: #STANDARD,
      value: 'ShortText'
    }
}
annotate entity ZC_ROC_INV_SET_I with
{
  @UI.facet: [{      id: 'SettlePOItem',
                     purpose: #STANDARD,
                     type: #IDENTIFICATION_REFERENCE,
                     position: 10,
                     targetQualifier: 'PO',
                     hidden: #(HidePOFields),
                     label: 'Settlement PO Item'  },
                     
              {      id: 'SettleNPOItem',
                     purpose: #STANDARD,
                     type: #IDENTIFICATION_REFERENCE,
                     position: 10,
                     targetQualifier: 'NPO',
                     hidden: #(HideNPOFields),
                     label: 'Settlement Non PO Item'  }
                     ]
                     
                     
  //SettleNo;
  @UI.lineItem: [{ position: 10, qualifier: 'PO' }, { position: 10, qualifier: 'NPO' }]
  @UI.identification: [{ position: 10, qualifier: 'PO' }, { position: 10, qualifier: 'NPO' }]
  @EndUserText.label: 'Item'
  ItemNo;


  //**************************************  PO Fields **************************************************************
  @UI.lineItem: [{ position: 20,  qualifier: 'PO' }]
  @UI.identification: [{  position: 20, qualifier: 'PO' }]
  //@UI.hidden: #(HidePOFields)
  @EndUserText.label: 'PO'
  PurchaseOrder;

  @UI.lineItem: [{ position: 30, qualifier: 'PO'}]
  @UI.identification: [{  position: 30, qualifier: 'PO' }]
  @EndUserText.label: 'PO Item'
  PurchaseOrderItem;


  @UI.lineItem: [{ position: 40,  qualifier: 'PO' }]
  @UI.identification: [{  position: 40,  qualifier: 'PO' }]
  @EndUserText.label: 'Material'
  Material;

  @UI.lineItem: [{ position: 50,  qualifier: 'PO' }]
  @UI.identification: [{  position: 50,  qualifier: 'PO' }]
  @EndUserText.label: 'Text'
  ShortText;

  @UI.lineItem: [{ position: 60,  qualifier: 'PO' }]
  @UI.identification: [{  position: 60,  qualifier: 'PO' }]
  @EndUserText.label: 'Quantity'
  Quantity;

  @UI.lineItem: [{ position: 70,  qualifier: 'PO' }]
  @UI.identification: [{  position: 70,  qualifier: 'PO' }]
  @EndUserText.label: 'Unit'
  OrderUnit;

  @UI.lineItem: [{ position: 80,  qualifier: 'PO' }]
  @UI.identification: [{  position: 80,  qualifier: 'PO' }]
  @EndUserText.label: 'Net Price'
  NetPrice;

  @UI.lineItem: [{ position: 90,  qualifier: 'PO' }]
  @UI.identification: [{  position: 90,  qualifier: 'PO' }]
  @EndUserText.label: 'Price Unit'
  PriceUnit;

  @UI.lineItem: [{ position: 100,  qualifier: 'PO' }]
  @UI.identification: [{  position: 100,  qualifier: 'PO' }]
  @EndUserText.label: 'Net Amount'
  DocumentAmount;

  @UI.lineItem: [{ position: 110,  qualifier: 'PO' }]
  @UI.identification: [{  position: 110,  qualifier: 'PO' }]
  @EndUserText.label: 'Planned Delivery Amount'
  PlannedDeliveryAmount;

  @UI.lineItem: [{ position: 120,  qualifier: 'PO' }]
  @UI.identification: [{  position: 120,  qualifier: 'PO' }]
  @EndUserText.label: 'Tax Code'
  TaxCode;

  @UI.lineItem: [{ position: 130,  qualifier: 'PO' }]
  @UI.identification: [{  position: 130,  qualifier: 'PO' }]
  @EndUserText.label: 'Tax Rate'
  TaxRate;

  @UI.lineItem: [{ position: 140,  qualifier: 'PO' }]
  @UI.identification: [{  position: 140,  qualifier: 'PO' }]
  @EndUserText.label: 'Tax Amount'
  TaxAmount;

  @UI.lineItem: [{ position: 150,  qualifier: 'PO' }]
  @UI.identification: [{  position: 150,  qualifier: 'PO' }]
  @EndUserText.label: 'Material Document'
  MaterialDocument;

  @UI.lineItem: [{ position: 160,  qualifier: 'PO' }]
  @UI.identification: [{  position: 160,  qualifier: 'PO' }]
  @EndUserText.label: 'Material Doc Year'
  MaterialDocYear;

  @UI.lineItem: [{ position: 170,  qualifier: 'PO' }]
  @UI.identification: [{  position: 170,  qualifier: 'PO' }]
  @EndUserText.label: 'Material Doc Item'
  MaterialDocItem;

  @UI.lineItem: [{ position: 180,  qualifier: 'PO' }]
  @UI.identification: [{  position: 180,  qualifier: 'PO' }]
  @EndUserText.label: 'Reference Document'
  ReferenceDocument;

  @UI.lineItem: [{ position: 190,  qualifier: 'PO' }]
  @UI.identification: [{  position: 190,  qualifier: 'PO' }]
  @EndUserText.label: 'Condition Type'
  ConditionType;

  //ExternalDelivery;


  //  Currency;
  //  PoType;
  //  PoDate;
  //  PoChangedDate;
  //  PoCreatedBy;
  //  Plant;
  //  StorageLocation;
  //  Batch;
  //
  //  EntryDate;
  //  EntryTime;


  //  DebitCredit;

  //**************************************  NonPO Fields **************************************************************
  @UI.lineItem: [{ position: 510, qualifier: 'NPO' }]
  @UI.identification: [{  position: 510, qualifier: 'NPO'  }]
  @EndUserText.label: 'GL Account'
  GlAccountNpo;

  @UI.lineItem: [{ position: 520, qualifier: 'NPO'  }]
  @UI.identification: [{  position: 520, qualifier: 'NPO' }]
  @EndUserText.label: 'Cost Center'
  CostCenterNpo;

  @UI.lineItem: [{ position: 530, qualifier: 'NPO'  }]
  @UI.identification: [{  position: 530, qualifier: 'NPO'  }]
  @EndUserText.label: 'Assignment'
  AssignmentNpo;

  @UI.lineItem: [{ position: 540, qualifier: 'NPO'  }]
  @UI.identification: [{  position: 540, qualifier: 'NPO'  }]
  @EndUserText.label: 'Text'
  ItemTextNpo;

  @UI.lineItem: [{ position: 550, qualifier: 'NPO'  }]
  @UI.identification: [{  position: 550, qualifier: 'NPO'  }]
  @EndUserText.label: 'Debit/Credit'
  DebitCreditNpo;

  @UI.lineItem: [{ position: 560, qualifier: 'NPO'  }]
  @UI.identification: [{  position: 560, qualifier: 'NPO'  }]
  @EndUserText.label: 'Net Amount'
  AmountNpo;

  @UI.lineItem: [{ position: 570, qualifier: 'NPO'  }]
  @UI.identification: [{  position: 570, qualifier: 'NPO'  }]
  @EndUserText.label: 'Tax Code'
  TaxCodeNpo;

  @UI.lineItem: [{ position: 580, qualifier: 'NPO'  }]
  @UI.identification: [{  position: 580, qualifier: 'NPO'  }]
  @EndUserText.label: 'Tax Rate'
  TaxRateNpo;

  @UI.lineItem: [{ position: 590, qualifier: 'NPO'  }]
  @UI.identification: [{  position: 590, qualifier: 'NPO'  }]
  @EndUserText.label: 'Tax Amount'
  TaxAmountNpo;
  /* Associations */
  //_invHeader;

}